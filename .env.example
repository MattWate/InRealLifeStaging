# Server-side only. Use the pooled Neon connection string in Netlify.
DATABASE_URL=postgresql://user:password@host-pooler.region.aws.neon.tech/neondb?sslmode=require&channel_binding=require

# Public application URL.
VITE_APP_URL=http://localhost:5173

# Server-side exact origin, no trailing slash. Set to the live HTTPS origin in Netlify.
# For local Netlify Dev use http://localhost:8888.
APP_ORIGIN=http://localhost:8888
